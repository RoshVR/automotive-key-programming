# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automotive_keys
DB_USER=postgres
DB_PASSWORD=your_password_here

# N8N Configuration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat
N8N_APPOINTMENT_WEBHOOK=https://your-n8n-instance.com/webhook/appointment

# Chatwoot Configuration
CHATWOOT_API_URL=https://your-chatwoot-instance.com/api/v1
CHATWOOT_API_TOKEN=your_chatwoot_token_here
CHATWOOT_INBOX_ID=your_inbox_id

# WhatsApp Configuration
WHATSAPP_NUMBER=+1234567890
WHATSAPP_MESSAGE_TEMPLATE=Hola, me gustaría agendar una cita para programación de llaves

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
