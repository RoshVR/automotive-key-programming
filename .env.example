# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automotive_keys
DB_USER=postgres
DB_PASSWORD=your_password_here

# N8N Workflow Database
N8N_DB_PASSWORD=your_n8n_db_password_here

# N8N Configuration
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here
N8N_HOST=your-subdomain.ngrok-free.app
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
N8N_WEBHOOK_URL=https://your-subdomain.ngrok-free.app/webhook/chat
N8N_APPOINTMENT_WEBHOOK=https://your-subdomain.ngrok-free.app/webhook/appointment

# Chatwoot Configuration
CHATWOOT_SECRET_KEY_BASE=your_chatwoot_secret_key_base_here
CHATWOOT_HOST=localhost:3001
CHATWOOT_INSTALLATION_NAME=AutomotiveKeys

# Chatwoot API
CHATWOOT_API_URL=http://localhost:3001/api/v1
CHATWOOT_API_TOKEN=your_chatwoot_token_here
CHATWOOT_INBOX_ID=1

# SMTP (optional)
SMTP_DOMAIN=smtp.gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_AUTHENTICATION=plain

# WhatsApp Configuration (optional)
WHATSAPP_NUMBER=+1234567890
WHATSAPP_MESSAGE_TEMPLATE=Hola, me gustaria agendar una cita para programacion de llaves

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis
REDIS_URL=redis://redis:6379

# Security
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5678
